<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>PasteOrbit</AssemblyName>
    <RootNamespace>PasteOrbit.App</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\Assets\PasteOrbit.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PasteOrbit.Core\PasteOrbit.Core.csproj" />
    <Content Include="..\..\Assets\PasteOrbit.ico" Link="Assets\PasteOrbit.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Strings\**\Resources.resw" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
    <Page Include="SettingsWindow.xaml" />
    <Compile Include="App.xaml.cs" />
    <Compile Include="AppLocalization.cs" />
    <Compile Include="AppSettings.cs" />
    <Compile Include="ClipboardTextContent.cs" />
    <Compile Include="ExplorerFilePaste.cs" />
    <Compile Include="GlobalHotKey.cs" />
    <Compile Include="GlobalUsings.cs" />
    <Compile Include="HistoryListItem.cs" />
    <Compile Include="LocalBackupService.cs" />
    <Compile Include="MainWindow.xaml.cs" />
    <Compile Include="SettingsWindow.xaml.cs" />
    <Compile Include="UpdateCheckService.cs" />
    <Compile Include="UpdateInstaller.cs" />
    <Compile Include="UiAutomationTarget.cs" />
    <Compile Include="Win32MessageBridge.cs" />
    <Compile Include="WpfClipboardMonitor.cs" />
    <Compile Include="WpfClipboardPlayback.cs" />
  </ItemGroup>
</Project>
