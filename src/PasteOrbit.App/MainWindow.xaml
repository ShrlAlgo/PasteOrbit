<Window
    x:Class="PasteOrbit.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PasteOrbit">
    <Grid x:Name="WindowSurface" Background="{ThemeResource PageBackgroundBrush}">
        <Grid x:Name="RootGrid" Background="Transparent">
            <Grid.Resources>
                <Style TargetType="FontIcon">
                    <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
                </Style>
                <Style x:Key="HeaderButtonStyle" TargetType="Button">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="AllowFocusOnInteraction" Value="False" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="2,0,0,0" />
                    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="6" />
                </Style>
                <Style x:Key="HeaderToggleButtonStyle" TargetType="ToggleButton">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="AllowFocusOnInteraction" Value="False" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="2,0,0,0" />
                    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="6" />
                </Style>
                <Style x:Key="RowActionButtonStyle" TargetType="Button">
                    <Setter Property="Width" Value="28" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="1,0,0,0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
                    <Setter Property="CornerRadius" Value="5" />
                </Style>
                <Style x:Key="FilterButtonStyle" TargetType="ToggleButton">
                    <Setter Property="Width" Value="36" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
                    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                    <Setter Property="Transitions">
                        <Setter.Value>
                            <TransitionCollection />
                        </Setter.Value>
                    </Setter>
                    <!--  仅让背景色过渡，图标内容保持静态，避免点击时字形参与重绘而变糊。  -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Grid>
                                    <Border
                                        x:Name="FilterChrome"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                        <Border.BackgroundTransition>
                                            <BrushTransition Duration="0:0:0.12" />
                                        </Border.BackgroundTransition>
                                    </Border>
                                    <ContentPresenter
                                        x:Name="FilterContentPresenter"
                                        Padding="{TemplateBinding Padding}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Foreground="{TemplateBinding Foreground}" />
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="FilterChrome.Background" Value="{ThemeResource SurfacePointerOverBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="FilterChrome.Background" Value="{ThemeResource SurfacePressedBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Target="FilterContentPresenter.Opacity" Value="0.5" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Checked">
                                                <VisualState.Setters>
                                                    <Setter Target="FilterChrome.Background" Value="{ThemeResource AccentBrush}" />
                                                    <Setter Target="FilterContentPresenter.Foreground" Value="{ThemeResource AccentForegroundBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="CheckedPointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="FilterChrome.Background" Value="{ThemeResource AccentPointerOverBrush}" />
                                                    <Setter Target="FilterContentPresenter.Foreground" Value="{ThemeResource AccentForegroundBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="CheckedPressed">
                                                <VisualState.Setters>
                                                    <Setter Target="FilterChrome.Background" Value="{ThemeResource AccentPressedBrush}" />
                                                    <Setter Target="FilterContentPresenter.Foreground" Value="{ThemeResource AccentForegroundBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="CheckedDisabled">
                                                <VisualState.Setters>
                                                    <Setter Target="FilterChrome.Background" Value="{ThemeResource AccentDisabledBrush}" />
                                                    <Setter Target="FilterContentPresenter.Foreground" Value="{ThemeResource AccentForegroundBrush}" />
                                                    <Setter Target="FilterContentPresenter.Opacity" Value="0.6" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="HistoryItemStyle" TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="HeaderGrid"
                Grid.Row="0"
                Margin="12,0,12,0"
                Background="{ThemeResource PageBackgroundBrush}"
                PointerCanceled="HeaderGrid_PointerCanceled"
                PointerCaptureLost="HeaderGrid_PointerCaptureLost"
                PointerPressed="HeaderGrid_PointerPressed"
                PointerMoved="HeaderGrid_PointerMoved"
                PointerReleased="HeaderGrid_PointerReleased">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Image
                        x:Name="AppIconImage"
                        x:Uid="AppIcon"
                        Width="20"
                        Height="20"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="PasteOrbit 应用图标"
                        Source="ms-appx:///Assets/PasteOrbit.ico" />
                    <TextBlock
                        x:Name="AppTitleText"
                        VerticalAlignment="Center"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextPrimaryBrush}"
                        Text="PasteOrbit" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        x:Name="SettingsButton"
                        x:Uid="MainSettingsButton"
                        AutomationProperties.Name="打开设置"
                        Click="SettingsButton_Click"
                        Style="{StaticResource HeaderButtonStyle}"
                        ToolTipService.ToolTip="设置">
                        <Viewbox
                            Width="14"
                            Height="14"
                            Stretch="Uniform">
                            <FontIcon Glyph="&#xE713;" />
                        </Viewbox>
                    </Button>
                    <ToggleButton
                        x:Name="WindowPinToggle"
                        x:Uid="MainWindowPinToggle"
                        AutomationProperties.Name="窗口置顶"
                        Checked="WindowPinToggle_Changed"
                        Style="{StaticResource HeaderToggleButtonStyle}"
                        ToolTipService.ToolTip="窗口置顶"
                        Unchecked="WindowPinToggle_Changed">
                        <Viewbox
                            Width="14"
                            Height="14"
                            Stretch="Uniform">
                            <FontIcon Glyph="&#xE718;" />
                        </Viewbox>
                    </ToggleButton>
                    <Button
                        x:Name="GitHubButton"
                        x:Uid="MainGitHubButton"
                        AutomationProperties.Name="打开 PasteOrbit GitHub 仓库"
                        Click="GitHubButton_Click"
                        Style="{StaticResource HeaderButtonStyle}"
                        ToolTipService.ToolTip="GitHub">
                        <Viewbox
                            Width="14"
                            Height="14"
                            Stretch="Uniform">
                            <FontIcon Glyph="&#xE71B;" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="18,0,18,10">
                <TextBox
                    x:Name="SearchBox"
                    x:Uid="MainSearchBox"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="搜索剪切板历史"
                    PlaceholderText="搜索剪切板历史"
                    TextChanged="SearchBox_TextChanged" />
            </Grid>

            <Grid Grid.Row="2" Margin="18,0,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ToggleButton
                        x:Name="AllFilterButton"
                        x:Uid="FilterAllButton"
                        AutomationProperties.Name="筛选全部"
                        Click="TypeFilter_Click"
                        IsChecked="True"
                        Style="{StaticResource FilterButtonStyle}"
                        Tag="All"
                        ToolTipService.ToolTip="全部">
                        <Viewbox
                            Width="18"
                            Height="18"
                            Stretch="Uniform">
                            <FontIcon Glyph="&#xE8A9;" />
                        </Viewbox>
                    </ToggleButton>
                    <ToggleButton
                        x:Name="TextFilterButton"
                        x:Uid="FilterTextButton"
                        AutomationProperties.Name="筛选文本"
                        Click="TypeFilter_Click"
                        Style="{StaticResource FilterButtonStyle}"
                        Tag="Text"
                        ToolTipService.ToolTip="文本">
                        <Viewbox
                            Width="18"
                            Height="18"
                            Stretch="Uniform">
                            <FontIcon Glyph="&#xE8D2;" />
                        </Viewbox>
                    </ToggleButton>
                    <ToggleButton
                        x:Name="ImageFilterButton"
                        x:Uid="FilterImageButton"
                        AutomationProperties.Name="筛选图片"
                        Click="TypeFilter_Click"
                        Style="{StaticResource FilterButtonStyle}"
                        Tag="Image"
                        ToolTipService.ToolTip="图片">
                        <Viewbox
                            Width="18"
                            Height="18"
                            Stretch="Uniform">
                            <FontIcon Glyph="&#xE8B9;" />
                        </Viewbox>
                    </ToggleButton>
                    <ToggleButton
                        x:Name="FilesFilterButton"
                        x:Uid="FilterFilesButton"
                        AutomationProperties.Name="筛选文件"
                        Click="TypeFilter_Click"
                        Style="{StaticResource FilterButtonStyle}"
                        Tag="Files"
                        ToolTipService.ToolTip="文件">
                        <Viewbox
                            Width="18"
                            Height="18"
                            Stretch="Uniform">
                            <FontIcon Glyph="&#xE8B7;" />
                        </Viewbox>
                    </ToggleButton>
                </StackPanel>
                <Button
                    x:Name="ClearHistoryButton"
                    x:Uid="ClearHistoryButton"
                    Grid.Column="1"
                    AutomationProperties.Name="清空剪切板历史"
                    Click="ClearHistoryButton_Click"
                    Style="{StaticResource HeaderButtonStyle}"
                    ToolTipService.ToolTip="清空剪切板历史">
                    <Viewbox
                        Width="16"
                        Height="16"
                        Stretch="Uniform">
                        <FontIcon Glyph="&#xE75C;" />
                    </Viewbox>
                </Button>
            </Grid>

            <Grid Grid.Row="3" Margin="18,0,4,0">
                <ListView
                    x:Name="HistoryList"
                    x:Uid="HistoryList"
                    Padding="0,0,14,0"
                    AutomationProperties.Name="剪切板历史记录"
                    IsItemClickEnabled="True"
                    ItemClick="HistoryList_ItemClick"
                    ItemContainerStyle="{StaticResource HistoryItemStyle}"
                    ContainerContentChanging="HistoryList_ContainerContentChanging"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionChanged="HistoryList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.Resources>
                        <!--  交互底色由圆角 HistoryCard 绘制，禁用列表容器自带的矩形状态层。  -->
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedDisabled" Color="Transparent" />
                        <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                    </ListView.Resources>
                    <!--  筛选会重建列表，禁用容器入场过渡，避免内容点击后逐渐清晰的模糊动画。  -->
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="HistoryCard"
                                Padding="0"
                                Background="{ThemeResource SurfaceBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                DataContextChanged="HistoryCard_DataContextChanged"
                                Loaded="HistoryCard_Loaded"
                                PointerEntered="HistoryCard_PointerEntered"
                                PointerExited="HistoryCard_PointerExited">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        x:Name="PinnedCardBackground"
                                        Grid.RowSpan="2"
                                        Background="{ThemeResource PinnedSurfaceBrush}"
                                        CornerRadius="8"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding PinnedVisibility}" />
                                    <Border
                                        x:Name="HistoryFocusBackground"
                                        Grid.RowSpan="2"
                                        Background="{ThemeResource HistoryFocusBrush}"
                                        CornerRadius="8"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                    <Grid Grid.Row="0" Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel
                                            Grid.Column="0"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                            <Image
                                                MaxWidth="300"
                                                MaxHeight="56"
                                                HorizontalAlignment="Left"
                                                Source="{Binding Thumbnail}"
                                                Stretch="Uniform" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                MaxLines="2"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextSecondaryBrush}"
                                                Text="{Binding OcrPreview}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding OcrTextVisibility}" />
                                            <TextBlock
                                                MaxLines="3"
                                                Text="{Binding Preview}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding TextContentVisibility}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Foreground="{ThemeResource TextSecondaryBrush}"
                                                Text="{Binding SourceLabel}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Right"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextSecondaryBrush}"
                                                Text="{Binding TimeLabel}" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Right"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextSecondaryBrush}"
                                                Text="{Binding Metadata}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Grid
                                            Grid.Column="2"
                                            Margin="8,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel
                                                Grid.Row="0"
                                                VerticalAlignment="Top"
                                                Orientation="Horizontal">
                                                <Button
                                                x:Name="RecordPreviewButton"
                                                x:Uid="RecordPreviewButton"
                                                AutomationProperties.Name="预览内容"
                                                Click="RecordPreviewButton_Click"
                                                Style="{StaticResource RowActionButtonStyle}"
                                                ToolTipService.ToolTip="预览内容">
                                                <Viewbox
                                                    Width="14"
                                                    Height="14"
                                                    Stretch="Uniform">
                                                    <FontIcon x:Name="RecordPreviewIcon" Glyph="&#xE890;" />
                                                </Viewbox>
                                                </Button>
                                                <Button
                                                AutomationProperties.Name="{Binding PinToolTip}"
                                                Click="RecordPinButton_Click"
                                                Style="{StaticResource RowActionButtonStyle}"
                                                ToolTipService.ToolTip="{Binding PinToolTip}">
                                                <Viewbox
                                                    Width="14"
                                                    Height="14"
                                                    Stretch="Uniform">
                                                    <FontIcon Glyph="{Binding PinGlyph}" />
                                                </Viewbox>
                                                </Button>
                                                <Button
                                                x:Name="RecordMoreButton"
                                                x:Uid="RecordMoreButton"
                                                AutomationProperties.Name="更多操作"
                                                Style="{StaticResource RowActionButtonStyle}"
                                                ToolTipService.ToolTip="更多操作">
                                                <FontIcon Glyph="&#xE712;" />
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuFlyoutItem
                                                            x:Name="PastePlainTextMenuItem"
                                                            x:Uid="PastePlainTextMenuItem"
                                                            Click="RecordPlainTextPasteButton_Click"
                                                            Tag="{Binding}"
                                                            Text="粘贴为纯文本"
                                                            Visibility="{Binding PlainTextPasteVisibility}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8D2;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem
                                                            x:Name="PasteOcrTextMenuItem"
                                                            x:Uid="PasteOcrTextMenuItem"
                                                            Click="RecordPasteOcrTextButton_Click"
                                                            Tag="{Binding}"
                                                            Text="粘贴识别文字"
                                                            Visibility="{Binding OcrTextVisibility}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8C8;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem
                                                            x:Name="PasteAsFileMenuItem"
                                                            x:Uid="PasteAsFileMenuItem"
                                                            Click="RecordPasteAsFileButton_Click"
                                                            Tag="{Binding}"
                                                            Text="粘贴为文件"
                                                            Visibility="{Binding PasteAsFileVisibility}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74E;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem
                                                            x:Name="DeleteRecordMenuItem"
                                                            x:Uid="DeleteRecordMenuItem"
                                                            Click="RecordDeleteButton_Click"
                                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                            Tag="{Binding}"
                                                            Text="删除记录">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                            <Grid
                                                Grid.Row="1"
                                                Margin="0,4,1,0"
                                                ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Padding="5,1"
                                                    Background="{ThemeResource SurfaceAltBrush}"
                                                    BorderBrush="{ThemeResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Visibility="{Binding QuickPasteVisibility}">
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextSecondaryBrush}"
                                                        Text="{Binding QuickPasteLabel}" />
                                                </Border>
                                                <Border
                                                    Grid.Column="2"
                                                    Padding="4,1"
                                                    HorizontalAlignment="Right"
                                                    Background="{ThemeResource SurfaceAltBrush}"
                                                    BorderBrush="{ThemeResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Visibility="{Binding FormatBadgeVisibility}">
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextSecondaryBrush}"
                                                        Text="{Binding FormatLabel}" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                    <Border
                                        x:Name="CardPreviewContent"
                                        Grid.Row="1"
                                        Margin="10,-2,10,10"
                                        Padding="8"
                                        Background="{ThemeResource SurfaceAltBrush}"
                                        BorderBrush="{ThemeResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="Collapsed">
                                        <ContentControl
                                            x:Name="CardPreviewHost"
                                            Height="168"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="EmptyText"
                    x:Uid="EmptyHistoryText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    Text="暂无剪切板记录"
                    Visibility="Collapsed" />
            </Grid>

            <Grid
                Grid.Row="4"
                Height="0"
                Visibility="Collapsed">
                <!--  保留名称供后台状态逻辑更新，但不再显示底部监听和条目数量文字。  -->
                <TextBlock x:Name="StatusText" />
                <TextBlock x:Name="CountText" />
            </Grid>
        </Grid>
    </Grid>
</Window>
