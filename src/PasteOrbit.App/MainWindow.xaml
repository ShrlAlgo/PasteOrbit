<Window x:Class="PasteOrbit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PasteOrbit.App"
        Title="PasteOrbit">
    <Grid x:Name="WindowSurface" Background="#F7F9FC">
    <Grid x:Name="RootGrid" RequestedTheme="Light" Background="Transparent">
    <Grid.Resources>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F7F9FC" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FBFCFE" />
        <SolidColorBrush x:Key="SurfacePointerOverBrush" Color="#F2F4F7" />
        <SolidColorBrush x:Key="SurfacePressedBrush" Color="#E4E7EC" />
        <SolidColorBrush x:Key="PinnedSurfaceBrush" Color="#EEF4FA" />
        <SolidColorBrush x:Key="HistoryFocusBrush" Color="#E8F3FF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D2939" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#667085" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#344054" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D9E1EA" />
        <SolidColorBrush x:Key="BorderPointerOverBrush" Color="#B8C4D2" />
        <SolidColorBrush x:Key="BorderPressedBrush" Color="#98A2B3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD" />
        <SolidColorBrush x:Key="AccentPointerOverBrush" Color="#0B5CAB" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#084C8D" />
        <SolidColorBrush x:Key="AccentDisabledBrush" Color="#A6D0F5" />
        <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="HeaderToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="RowActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style x:Key="FilterButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Transitions">
                <Setter.Value>
                    <TransitionCollection />
                </Setter.Value>
            </Setter>
            <!-- 仅让背景色过渡，图标内容保持静态，避免点击时字形参与重绘而变糊。 -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="FilterChrome"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <Border.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.12" />
                                </Border.BackgroundTransition>
                            </Border>
                            <ContentPresenter x:Name="FilterContentPresenter"
                                              Foreground="{TemplateBinding Foreground}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="FilterChrome.Background" Value="{StaticResource SurfacePointerOverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="FilterChrome.Background" Value="{StaticResource SurfacePressedBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="FilterContentPresenter.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="FilterChrome.Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Target="FilterContentPresenter.Foreground" Value="{StaticResource AccentForegroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="FilterChrome.Background" Value="{StaticResource AccentPointerOverBrush}" />
                                            <Setter Target="FilterContentPresenter.Foreground" Value="{StaticResource AccentForegroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="FilterChrome.Background" Value="{StaticResource AccentPressedBrush}" />
                                            <Setter Target="FilterContentPresenter.Foreground" Value="{StaticResource AccentForegroundBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="FilterChrome.Background" Value="{StaticResource AccentDisabledBrush}" />
                                            <Setter Target="FilterContentPresenter.Foreground" Value="{StaticResource AccentForegroundBrush}" />
                                            <Setter Target="FilterContentPresenter.Opacity" Value="0.6" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactHistoryItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>
        <Style x:Key="ComfortableHistoryItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="0" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="12,0,140,0"
              Background="{StaticResource PageBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Width="20" Height="20" Margin="0,0,8,0"
                       Source="ms-appx:///Assets/PasteOrbit.ico"
                       AutomationProperties.Name="PasteOrbit 应用图标" />
                <TextBlock Text="PasteOrbit" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button x:Name="SettingsButton" Style="{StaticResource HeaderButtonStyle}" Click="SettingsButton_Click"
                        ToolTipService.ToolTip="设置" AutomationProperties.Name="打开设置">
                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                        <SymbolIcon Symbol="Setting" />
                    </Viewbox>
                </Button>
                <ToggleButton x:Name="WindowPinToggle" Style="{StaticResource HeaderToggleButtonStyle}"
                              Checked="WindowPinToggle_Changed" Unchecked="WindowPinToggle_Changed"
                              ToolTipService.ToolTip="窗口置顶" AutomationProperties.Name="窗口置顶">
                    <Viewbox Width="14" Height="14" Stretch="Uniform">
                        <SymbolIcon Symbol="Pin" />
                    </Viewbox>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="18,0,18,10">
            <AutoSuggestBox x:Name="SearchBox"
                            PlaceholderText="搜索剪切板历史" TextChanged="SearchBox_TextChanged"
                            VerticalAlignment="Center" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="搜索剪切板历史">
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
        </Grid>

        <Grid Grid.Row="2" Margin="18,0,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ToggleButton x:Name="AllFilterButton" Tag="All" IsChecked="True" Style="{StaticResource FilterButtonStyle}" Click="TypeFilter_Click"
                              ToolTipService.ToolTip="全部" AutomationProperties.Name="筛选全部">
                    <Viewbox Width="18" Height="18" Stretch="Uniform">
                        <SymbolIcon Symbol="ViewAll" />
                    </Viewbox>
                </ToggleButton>
                <ToggleButton x:Name="TextFilterButton" Tag="Text" Style="{StaticResource FilterButtonStyle}" Click="TypeFilter_Click"
                              ToolTipService.ToolTip="文本" AutomationProperties.Name="筛选文本">
                    <Viewbox Width="18" Height="18" Stretch="Uniform">
                        <SymbolIcon Symbol="Font" />
                    </Viewbox>
                </ToggleButton>
                <ToggleButton x:Name="ImageFilterButton" Tag="Image" Style="{StaticResource FilterButtonStyle}" Click="TypeFilter_Click"
                              ToolTipService.ToolTip="图片" AutomationProperties.Name="筛选图片">
                    <Viewbox Width="18" Height="18" Stretch="Uniform">
                        <SymbolIcon Symbol="Pictures" />
                    </Viewbox>
                </ToggleButton>
                <ToggleButton x:Name="FilesFilterButton" Tag="Files" Style="{StaticResource FilterButtonStyle}" Click="TypeFilter_Click"
                              ToolTipService.ToolTip="文件" AutomationProperties.Name="筛选文件">
                    <Viewbox Width="18" Height="18" Stretch="Uniform">
                        <SymbolIcon Symbol="Folder" />
                    </Viewbox>
                </ToggleButton>
            </StackPanel>
            <Button x:Name="ClearHistoryButton" Grid.Column="1" Style="{StaticResource HeaderButtonStyle}" Click="ClearHistoryButton_Click"
                    ToolTipService.ToolTip="清空剪切板历史" AutomationProperties.Name="清空剪切板历史">
                <Viewbox Width="16" Height="16" Stretch="Uniform">
                    <SymbolIcon Symbol="Clear" />
                </Viewbox>
            </Button>
        </Grid>

        <Grid Grid.Row="3" Margin="18,0,4,0">
            <ListView x:Name="HistoryList" IsItemClickEnabled="True" ItemClick="HistoryList_ItemClick" SelectionChanged="HistoryList_SelectionChanged"
                      SelectionMode="Single" ItemContainerStyle="{StaticResource CompactHistoryItemStyle}"
                      Padding="0,0,14,0"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      AutomationProperties.Name="剪切板历史记录">
                <!-- 筛选会重建列表，禁用容器入场过渡，避免内容点击后逐渐清晰的模糊动画。 -->
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10"
                                Loaded="HistoryCard_Loaded"
                                DataContextChanged="HistoryCard_DataContextChanged"
                                PointerEntered="HistoryCard_PointerEntered" PointerExited="HistoryCard_PointerExited">
                            <Grid>
                                <Border x:Name="PinnedCardBackground" Margin="-10" CornerRadius="8" Background="{StaticResource PinnedSurfaceBrush}"
                                        Visibility="{Binding PinnedVisibility}" IsHitTestVisible="False" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="Uniform" HorizontalAlignment="Left" MaxWidth="300" MaxHeight="56" />
                                        <TextBlock Text="{Binding Preview}" Visibility="{Binding TextContentVisibility}"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="42" />
                                        <TextBlock Text="{Binding Metadata}" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SourceLabel}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TimeLabel}" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Button Style="{StaticResource RowActionButtonStyle}" Click="RecordPasteAsFileButton_Click"
                                                Visibility="{Binding PasteAsFileVisibility}" ToolTipService.ToolTip="粘贴为文件" AutomationProperties.Name="粘贴为文件">
                                            <Viewbox Width="14" Height="14" Stretch="Uniform">
                                                <SymbolIcon Symbol="Save" />
                                            </Viewbox>
                                        </Button>
                                        <Button Style="{StaticResource RowActionButtonStyle}" Click="RecordPinButton_Click" ToolTipService.ToolTip="{Binding PinToolTip}" AutomationProperties.Name="{Binding PinToolTip}">
                                            <Viewbox Width="14" Height="14" Stretch="Uniform">
                                                <SymbolIcon Symbol="{Binding PinSymbol}" />
                                            </Viewbox>
                                        </Button>
                                        <Button Style="{StaticResource RowActionButtonStyle}" Click="RecordDeleteButton_Click" ToolTipService.ToolTip="删除记录" AutomationProperties.Name="删除记录">
                                            <Viewbox Width="14" Height="14" Stretch="Uniform">
                                                <SymbolIcon Symbol="Delete" />
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyText" Text="暂无剪切板记录" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>

        <Grid Grid.Row="4" Height="0" Visibility="Collapsed">
            <!-- 保留名称供后台状态逻辑更新，但不再显示底部监听和条目数量文字。 -->
            <TextBlock x:Name="StatusText" />
            <TextBlock x:Name="CountText" />
        </Grid>
    </Grid>
    </Grid>
</Window>
