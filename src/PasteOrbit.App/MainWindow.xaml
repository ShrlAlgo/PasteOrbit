<Window x:Class="PasteOrbit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PasteOrbit" Width="460" Height="590" MinWidth="380" MinHeight="420"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        ShowInTaskbar="False" Topmost="False" ResizeMode="CanResizeWithGrip">
    <Border Padding="14,10,10,10" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="42" />
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="17" Height="17" Margin="2,0,8,0" HorizontalAlignment="Left" Source="Assets/PasteOrbit.ico" />
                <TextBlock Margin="28,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="PasteOrbit" />
                <Button Grid.Column="1" Style="{StaticResource TitleBarIconButtonStyle}" ToolTip="设置" Click="SettingsButton_Click">
                    <Viewbox Width="14" Height="14"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" /></Viewbox>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource TitleBarIconButtonStyle}" ToolTip="GitHub" Click="GitHubButton_Click">
                    <Viewbox Width="15" Height="15">
                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M12,0.5 C5.37,0.5 0,5.87 0,12.5 C0,17.8 3.44,22.3 8.2,23.88 C8.8,23.99 9.02,23.62 9.02,23.3 L9,21.26 C5.66,21.99 4.96,19.85 4.96,19.85 C4.42,18.46 3.63,18.09 3.63,18.09 C2.54,17.35 3.71,17.36 3.71,17.36 C4.91,17.45 5.55,18.6 5.55,18.6 C6.62,20.43 8.36,19.9 9.05,19.59 C9.16,18.81 9.47,18.28 9.81,17.98 C7.14,17.68 4.34,16.65 4.34,12.05 C4.34,10.74 4.81,9.67 5.58,8.84 C5.46,8.54 5.04,7.32 5.7,5.67 C5.7,5.67 6.71,5.35 9,6.9 C9.96,6.63 10.98,6.49 12,6.49 C13.02,6.49 14.04,6.63 15,6.9 C17.29,5.35 18.3,5.67 18.3,5.67 C18.96,7.32 18.54,8.54 18.42,8.84 C19.19,9.67 19.66,10.74 19.66,12.05 C19.66,16.66 16.85,17.67 14.18,17.97 C14.61,18.34 15,19.08 15,20.21 L14.98,23.3 C14.98,23.62 15.2,24 15.81,23.88 C20.56,22.3 24,17.8 24,12.5 C24,5.87 18.63,0.5 12,0.5 Z" />
                    </Viewbox>
                </Button>
                <Button x:Name="PinWindowButton" Grid.Column="3" Style="{StaticResource TitleBarIconButtonStyle}" ToolTip="窗口置顶" Click="PinWindowButton_Click">
                    <Viewbox Width="14" Height="14"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE718;" /></Viewbox>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource TitleBarIconButtonStyle}" ToolTip="隐藏" Click="CloseButton_Click">
                    <Viewbox Width="12" Height="12"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" /></Viewbox>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,3,4,3">
                <TextBox x:Name="SearchBox" FontSize="14" TextChanged="SearchBox_TextChanged" />
                <TextBlock Margin="11,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           IsHitTestVisible="False" Text="搜索剪切板历史">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <ToggleButton x:Name="AllFilter" Style="{StaticResource FilterToggleButtonStyle}" Margin="0,2,6,4" IsChecked="True"
                              Checked="Filter_Checked">
                    <Viewbox Width="15" Height="15"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xF0E2;" /></Viewbox>
                </ToggleButton>
                <ToggleButton x:Name="TextFilter" Style="{StaticResource FilterToggleButtonStyle}" Margin="0,2,6,4"
                              Checked="Filter_Checked">
                    <Viewbox Width="15" Height="15"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8D2;" /></Viewbox>
                </ToggleButton>
                <ToggleButton x:Name="ImageFilter" Style="{StaticResource FilterToggleButtonStyle}" Margin="0,2,6,4"
                              Checked="Filter_Checked">
                    <Viewbox Width="15" Height="15"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEB9F;" /></Viewbox>
                </ToggleButton>
                <ToggleButton x:Name="FilesFilter" Style="{StaticResource FilterToggleButtonStyle}" Margin="0,2,6,4"
                              Checked="Filter_Checked">
                    <Viewbox Width="15" Height="15"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" /></Viewbox>
                </ToggleButton>
                <Button Width="36" Height="32" MinWidth="0" MinHeight="0" Padding="0" Margin="2,2,0,4"
                        ToolTip="清空当前列表" Click="ClearButton_Click">
                    <Viewbox Width="15" Height="15"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" /></Viewbox>
                </Button>
            </StackPanel>

            <ListBox x:Name="HistoryList" Grid.Row="3" Margin="0,0,0,0" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="HistoryList_PreviewMouseLeftButtonUp"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True" KeyDown="HistoryList_KeyDown">
                <ListBox.Resources>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,4,7" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10,8">
                                        <Border.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="粘贴为纯文本" Click="PastePlainTextMenuItem_Click" />
                                                <MenuItem Header="粘贴为文件" Click="PasteAsFileMenuItem_Click" />
                                                <Separator />
                                                <MenuItem Header="删除" Click="DeleteMenuItem_Click" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock MaxHeight="42" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13.5"
                                           Text="{Binding PreviewText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                <Image MaxWidth="220" MaxHeight="110" Margin="0,3,0,0" HorizontalAlignment="Left"
                                       Stretch="Uniform" Source="{Binding Thumbnail}" Visibility="{Binding ImageVisibility}"
                                       Loaded="Thumbnail_Loaded" />
                                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11.5"
                                           Text="{Binding DetailText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                           Text="{Binding SourceApplication}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="11" Text="{Binding TimeText}" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource CompactIconButtonStyle}" VerticalAlignment="Center"
                                    Foreground="{Binding PinBrush}" Click="PinItemButton_Click" ToolTip="置顶">
                                <Viewbox Width="13" Height="13"><TextBlock FontFamily="Segoe Fluent Icons" Text="{Binding PinGlyph}" /></Viewbox>
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource CompactIconButtonStyle}" VerticalAlignment="Center"
                                    Click="DeleteItemButton_Click" ToolTip="删除">
                                <Viewbox Width="13" Height="13"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" /></Viewbox>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
