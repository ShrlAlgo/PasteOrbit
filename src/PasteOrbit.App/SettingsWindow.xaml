<Window x:Class="PasteOrbit.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PasteOrbit 设置" Width="620" Height="680" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" Text="设置" />
        <ScrollViewer Grid.Row="1" Margin="0,20,0,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="常规" />
                <Grid Margin="0,12,8,8">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="语言" />
                    <ComboBox x:Name="LanguageBox" Grid.Column="1" SelectedValuePath="Tag">
                        <ComboBoxItem Content="跟随系统" Tag="" />
                        <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                        <ComboBoxItem Content="English" Tag="en-US" />
                    </ComboBox>
                </Grid>
                <Grid Margin="0,8,8,8">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="主题" />
                    <ComboBox x:Name="ThemeBox" Grid.Column="1" SelectedValuePath="Tag">
                        <ComboBoxItem Content="跟随系统" Tag="System" />
                        <ComboBoxItem Content="浅色" Tag="Light" />
                        <ComboBoxItem Content="深色" Tag="Dark" />
                    </ComboBox>
                </Grid>
                <CheckBox x:Name="AutoHideBox" Margin="0,8" Content="窗口失去焦点时自动隐藏" />
                <CheckBox x:Name="StartWithWindowsBox" Margin="0,8" Content="随 Windows 启动" />

                <Separator Margin="0,16" />
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="捕获" />
                <CheckBox x:Name="MonitorTextBox" Margin="0,12,0,6" Content="记录文本" />
                <CheckBox x:Name="MonitorImagesBox" Margin="0,6" Content="记录图片" />
                <CheckBox x:Name="MonitorFilesBox" Margin="0,6" Content="记录文件" />
                <Grid Margin="0,10,8,6">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="排除应用（分号分隔）" />
                    <TextBox x:Name="ExcludedAppsBox" Grid.Column="1" />
                </Grid>

                <Separator Margin="0,16" />
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="历史" />
                <Grid Margin="0,12,8,6">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="保留天数" />
                    <TextBox x:Name="RetentionDaysBox" Grid.Column="1" />
                </Grid>
                <Grid Margin="0,8,8,6">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="最大记录数" />
                    <TextBox x:Name="MaxEntriesBox" Grid.Column="1" />
                </Grid>

                <Separator Margin="0,16" />
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="快捷键" />
                <Grid Margin="0,12,8,6">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="打开历史面板" />
                    <TextBox x:Name="HotKeyBox" Grid.Column="1" PreviewKeyDown="HotKeyBox_PreviewKeyDown" IsReadOnly="True" />
                </Grid>

                <Separator Margin="0,16" />
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="数据" />
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Content="导出备份" Click="ExportButton_Click" />
                    <Button Margin="0,0,8,0" Content="恢复备份" Click="RestoreButton_Click" />
                    <Button Content="检查更新" Click="UpdateButton_Click" />
                </StackPanel>
                <TextBlock x:Name="VersionText" Margin="0,14,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,8,0" Content="恢复默认" Click="ResetButton_Click" />
            <Button Width="88" Style="{DynamicResource AccentButtonStyle}" Content="保存" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
