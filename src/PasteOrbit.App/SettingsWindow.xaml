<Window
    x:Class="PasteOrbit.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:PasteOrbit.App"
    Title="PasteOrbit 设置">
    <Grid x:Name="SettingsRoot" Background="{ThemeResource PageBackgroundBrush}">
        <Grid.Resources>
            <Style TargetType="FontIcon">
                <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
            </Style>
            <Style TargetType="toolkit:SettingsCard">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="toolkit:SettingsCard">
                            <Border
                                MinHeight="64"
                                Padding="16,12"
                                Background="{ThemeResource SurfaceBrush}"
                                BorderBrush="{ThemeResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{TemplateBinding Header}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                            Text="{TemplateBinding Description}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ContentPresenter
                                        Grid.Column="1"
                                        HorizontalAlignment="{TemplateBinding ContentAlignment}"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ShortcutButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="180" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="IsTabStop" Value="True" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="SettingsTitleBar"
            x:Uid="SettingsTitleBar"
            Title="PasteOrbit 设置"
            Grid.Row="0"
            AutomationProperties.Name="PasteOrbit 设置标题栏"
            BackRequested="SettingsTitleBar_BackRequested"
            Background="{ThemeResource PageBackgroundBrush}"
            Foreground="{ThemeResource TextPrimaryBrush}"
            IsBackButtonEnabled="True"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="SettingsTitleBar_PaneToggleRequested" />

        <NavigationView
            x:Name="SettingsNavigation"
            Grid.Row="1"
            Background="{ThemeResource SurfaceBrush}"
            CompactModeThresholdWidth="640"
            CompactPaneLength="48"
            ExpandedModeThresholdWidth="760"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="200"
            PaneDisplayMode="Auto"
            SelectionChanged="SettingsNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="GeneralNavigationItem"
                    x:Uid="SettingsGeneralNavigation"
                    Content="常规"
                    IsSelected="True"
                    Tag="General">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="HotKeyNavigationItem"
                    x:Uid="SettingsHotKeyNavigation"
                    Content="快捷键"
                    Tag="HotKey">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="HistoryNavigationItem"
                    x:Uid="SettingsHistoryNavigation"
                    Content="历史记录"
                    Tag="History">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="PrivacyNavigationItem"
                    x:Uid="SettingsPrivacyNavigation"
                    Content="隐私与安全"
                    Tag="Privacy">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.Content>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="42,26,42,24">
                        <StackPanel x:Name="GeneralPanel">
                            <TextBlock
                                x:Name="StartupSectionText"
                                x:Uid="SettingsStartupSection"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="启动与窗口" />
                            <Border
                                Height="1"
                                Margin="0,8,0,4"
                                Background="{ThemeResource BorderBrush}" />
                            <toolkit:SettingsCard
                                x:Name="StartupCard"
                                x:Uid="SettingsStartupCard"
                                Margin="0,0,0,8"
                                ContentAlignment="Right"
                                Description="登录 Windows 后自动运行 PasteOrbit"
                                Header="开机自动启动">
                                <ToggleSwitch x:Name="StartWithWindowsToggleSwitch" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                x:Name="AutoHideCard"
                                x:Uid="SettingsAutoHideCard"
                                Margin="0,0,0,8"
                                ContentAlignment="Right"
                                Description="窗口失去焦点后自动收起历史面板"
                                Header="失去焦点时自动隐藏">
                                <ToggleSwitch x:Name="AutoHideToggleSwitch" />
                            </toolkit:SettingsCard>
                            <TextBlock
                                x:Name="MonitoringSectionText"
                                x:Uid="SettingsMonitoringSection"
                                Margin="0,18,0,0"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="剪贴板监听" />
                            <Border
                                Height="1"
                                Margin="0,8,0,4"
                                Background="{ThemeResource BorderBrush}" />
                            <toolkit:SettingsCard
                                x:Name="MonitorTextCard"
                                x:Uid="SettingsMonitorTextCard"
                                Margin="0,0,0,8"
                                ContentAlignment="Right"
                                Description="记录复制到剪贴板的文本内容"
                                Header="监听文本">
                                <ToggleSwitch x:Name="MonitorTextToggleSwitch" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                x:Name="MonitorImagesCard"
                                x:Uid="SettingsMonitorImagesCard"
                                Margin="0,0,0,8"
                                ContentAlignment="Right"
                                Description="记录复制到剪贴板的图片内容"
                                Header="监听图片">
                                <ToggleSwitch x:Name="MonitorImagesToggleSwitch" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                x:Name="ImageOcrCard"
                                x:Uid="SettingsImageOcrCard"
                                Margin="0,0,0,8"
                                ContentAlignment="Right"
                                Description="使用 Windows OCR 提取新复制图片中的文字，并用于搜索"
                                Header="自动识别图片文字">
                                <ToggleSwitch x:Name="ImageOcrToggleSwitch" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                x:Name="MonitorFilesCard"
                                x:Uid="SettingsMonitorFilesCard"
                                Margin="0,0,0,8"
                                ContentAlignment="Right"
                                Description="记录复制到剪贴板的文件内容"
                                Header="监听文件">
                                <ToggleSwitch x:Name="MonitorFilesToggleSwitch" />
                            </toolkit:SettingsCard>
                            <TextBlock
                                x:Name="AppearanceSectionText"
                                x:Uid="SettingsAppearanceSection"
                                Margin="0,18,0,0"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="外观" />
                            <Border
                                Height="1"
                                Margin="0,8,0,4"
                                Background="{ThemeResource BorderBrush}" />
                            <toolkit:SettingsCard
                                x:Name="ThemeCard"
                                x:Uid="SettingsThemeCard"
                                Margin="0,0,0,8"
                                ContentAlignment="Right"
                                Description="选择浅色、深色或跟随系统"
                                Header="主题模式">
                                <ComboBox x:Name="ThemeComboBox" Width="180">
                                    <ComboBoxItem
                                        x:Name="ThemeSystemOption"
                                        x:Uid="ThemeSystemOption"
                                        Content="跟随系统"
                                        Tag="System" />
                                    <ComboBoxItem
                                        x:Name="ThemeLightOption"
                                        x:Uid="ThemeLightOption"
                                        Content="浅色"
                                        Tag="Light" />
                                    <ComboBoxItem
                                        x:Name="ThemeDarkOption"
                                        x:Uid="ThemeDarkOption"
                                        Content="深色"
                                        Tag="Dark" />
                                </ComboBox>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                x:Name="LanguageCard"
                                x:Uid="SettingsLanguageCard"
                                Margin="0,0,0,8"
                                ContentAlignment="Right"
                                Description="更改会立即生效"
                                Header="显示语言">
                                <ComboBox x:Name="LanguageComboBox" Width="180">
                                    <ComboBoxItem
                                        x:Name="LanguageSystemOption"
                                        x:Uid="LanguageSystemOption"
                                        Content="跟随系统"
                                        Tag="System" />
                                    <ComboBoxItem
                                        x:Name="LanguageChineseOption"
                                        x:Uid="LanguageChineseOption"
                                        Content="简体中文"
                                        Tag="zh-CN" />
                                    <ComboBoxItem
                                        x:Name="LanguageEnglishOption"
                                        x:Uid="LanguageEnglishOption"
                                        Content="English"
                                        Tag="en-US" />
                                </ComboBox>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                x:Name="UpdateCard"
                                x:Uid="SettingsUpdateCard"
                                Margin="0,0,0,8"
                                ContentAlignment="Right"
                                Description="检查 PasteOrbit 是否有新版本"
                                Header="软件更新">
                                <Button
                                    x:Name="CheckForUpdatesButton"
                                    x:Uid="CheckForUpdatesButton"
                                    Click="CheckForUpdatesButton_Click"
                                    Content="检查更新" />
                            </toolkit:SettingsCard>
                        </StackPanel>

                        <StackPanel x:Name="HotKeyPanel" Visibility="Collapsed">
                            <TextBlock
                                x:Name="HotKeySectionText"
                                x:Uid="SettingsHotKeySection"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="快捷键" />
                            <Border
                                Height="1"
                                Margin="0,8,0,4"
                                Background="{ThemeResource BorderBrush}" />
                            <toolkit:SettingsCard
                                x:Name="GlobalHotKeyCard"
                                x:Uid="SettingsGlobalHotKeyCard"
                                Margin="0,0,0,8"
                                ContentAlignment="Right"
                                Description="全局快捷键，必须包含修饰键"
                                Header="打开剪切板历史">
                                <Button
                                    x:Name="HotKeyButton"
                                    Click="ShortcutButton_Click"
                                    KeyDown="ShortcutButton_KeyDown"
                                    LostFocus="ShortcutButton_LostFocus"
                                    Style="{StaticResource ShortcutButtonStyle}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                x:Name="PasteShortcutCard"
                                x:Uid="SettingsPasteShortcutCard"
                                Margin="0,0,0,8"
                                ContentAlignment="Right"
                                Header="粘贴选中记录">
                                <Button
                                    x:Name="PasteShortcutButton"
                                    Click="ShortcutButton_Click"
                                    KeyDown="ShortcutButton_KeyDown"
                                    LostFocus="ShortcutButton_LostFocus"
                                    Style="{StaticResource ShortcutButtonStyle}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                x:Name="PlainTextShortcutCard"
                                x:Uid="SettingsPlainTextShortcutCard"
                                Margin="0,0,0,8"
                                ContentAlignment="Right"
                                Header="粘贴为纯文本">
                                <Button
                                    x:Name="PlainTextPasteShortcutButton"
                                    Click="ShortcutButton_Click"
                                    KeyDown="ShortcutButton_KeyDown"
                                    LostFocus="ShortcutButton_LostFocus"
                                    Style="{StaticResource ShortcutButtonStyle}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                x:Name="PreviewShortcutCard"
                                x:Uid="SettingsPreviewShortcutCard"
                                Margin="0,0,0,8"
                                ContentAlignment="Right"
                                Header="展开或收起预览">
                                <Button
                                    x:Name="PreviewShortcutButton"
                                    Click="ShortcutButton_Click"
                                    KeyDown="ShortcutButton_KeyDown"
                                    LostFocus="ShortcutButton_LostFocus"
                                    Style="{StaticResource ShortcutButtonStyle}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                x:Name="PinShortcutCard"
                                x:Uid="SettingsPinShortcutCard"
                                Margin="0,0,0,8"
                                ContentAlignment="Right"
                                Header="置顶或取消置顶">
                                <Button
                                    x:Name="PinShortcutButton"
                                    Click="ShortcutButton_Click"
                                    KeyDown="ShortcutButton_KeyDown"
                                    LostFocus="ShortcutButton_LostFocus"
                                    Style="{StaticResource ShortcutButtonStyle}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                x:Name="DeleteShortcutCard"
                                x:Uid="SettingsDeleteShortcutCard"
                                Margin="0,0,0,8"
                                ContentAlignment="Right"
                                Header="删除选中记录">
                                <Button
                                    x:Name="DeleteShortcutButton"
                                    Click="ShortcutButton_Click"
                                    KeyDown="ShortcutButton_KeyDown"
                                    LostFocus="ShortcutButton_LostFocus"
                                    Style="{StaticResource ShortcutButtonStyle}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                x:Name="PasteAsFileShortcutCard"
                                x:Uid="SettingsPasteAsFileShortcutCard"
                                Margin="0,0,0,8"
                                ContentAlignment="Right"
                                Header="粘贴为文件">
                                <Button
                                    x:Name="PasteAsFileShortcutButton"
                                    Click="ShortcutButton_Click"
                                    KeyDown="ShortcutButton_KeyDown"
                                    LostFocus="ShortcutButton_LostFocus"
                                    Style="{StaticResource ShortcutButtonStyle}" />
                            </toolkit:SettingsCard>
                            <TextBlock
                                x:Name="ShortcutHintText"
                                x:Uid="SettingsShortcutHint"
                                Margin="0,4,0,0"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Text="Esc 隐藏面板，方向键用于列表导航，这些系统操作保持固定。"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel x:Name="HistoryPanel" Visibility="Collapsed">
                            <TextBlock
                                x:Name="HistorySectionText"
                                x:Uid="SettingsHistorySection"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="历史记录" />
                            <Border
                                Height="1"
                                Margin="0,8,0,4"
                                Background="{ThemeResource BorderBrush}" />
                            <toolkit:SettingsCard
                                x:Name="RetentionCard"
                                x:Uid="SettingsRetentionCard"
                                Margin="0,0,0,8"
                                ContentAlignment="Right"
                                Description="自动清理超过该天数的未置顶记录"
                                Header="保留天数">
                                <ComboBox x:Name="RetentionDaysComboBox" Width="180">
                                    <ComboBoxItem Content="7" />
                                    <ComboBoxItem Content="30" />
                                    <ComboBoxItem Content="90" />
                                    <ComboBoxItem Content="365" />
                                </ComboBox>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                x:Name="MaxEntriesCard"
                                x:Uid="SettingsMaxEntriesCard"
                                Margin="0,0,0,8"
                                ContentAlignment="Right"
                                Description="达到上限时优先清理未置顶记录"
                                Header="最多记录数">
                                <ComboBox x:Name="MaxEntriesComboBox" Width="180">
                                    <ComboBoxItem Content="1000" />
                                    <ComboBoxItem Content="5000" />
                                    <ComboBoxItem Content="10000" />
                                </ComboBox>
                            </toolkit:SettingsCard>
                            <TextBlock
                                x:Name="PinnedRetentionHintText"
                                x:Uid="SettingsPinnedRetentionHint"
                                Margin="0,12,0,0"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Text="置顶记录不参与自动过期和数量清理。"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel x:Name="PrivacyPanel" Visibility="Collapsed">
                            <TextBlock
                                x:Name="PrivacySectionText"
                                x:Uid="SettingsPrivacySection"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="隐私与安全" />
                            <Border
                                Height="1"
                                Margin="0,8,0,4"
                                Background="{ThemeResource BorderBrush}" />
                            <toolkit:SettingsCard
                                x:Name="ExcludedAppsCard"
                                x:Uid="SettingsExcludedAppsCard"
                                Margin="0,0,0,8"
                                ContentAlignment="Right"
                                Description="填写进程名或从当前运行进程中选择，多个进程用分号分隔"
                                Header="不记录指定应用">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox
                                        x:Name="ExcludedApplicationsTextBox"
                                        x:Uid="ExcludedApplicationsTextBox"
                                        Width="240"
                                        PlaceholderText="进程名，用分号分隔" />
                                    <Button
                                        x:Name="SelectProcessButton"
                                        x:Uid="SelectProcessButton"
                                        AutomationProperties.Name="选择进程"
                                        Click="SelectExcludedApplicationButton_Click" />
                                </StackPanel>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                x:Name="BackupCard"
                                x:Uid="SettingsBackupCard"
                                Margin="0,0,0,8"
                                ContentAlignment="Right"
                                Description="导出或恢复由当前 Windows 用户凭据保护的备份文件"
                                Header="本地加密备份">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="ExportBackupButton"
                                        x:Uid="ExportBackupButton"
                                        Click="ExportBackupButton_Click"
                                        Content="导出备份" />
                                    <Button
                                        x:Name="RestoreBackupButton"
                                        x:Uid="RestoreBackupButton"
                                        Click="RestoreBackupButton_Click"
                                        Content="恢复备份" />
                                </StackPanel>
                            </toolkit:SettingsCard>
                            <TextBlock
                                x:Name="ProtectionTitleText"
                                x:Uid="SettingsProtectionTitle"
                                Margin="0,22,0,8"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="本地数据保护已启用" />
                            <TextBlock
                                x:Name="ProtectionDescriptionText"
                                x:Uid="SettingsProtectionDescription"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Text="剪切板正文使用当前 Windows 用户凭据加密，其他用户无法直接读取。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </NavigationView.Content>
        </NavigationView>

        <Border
            Grid.Row="2"
            Background="{ThemeResource SurfaceBrush}"
            BorderBrush="{ThemeResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Button
                    x:Name="RestoreDefaultsButton"
                    x:Uid="RestoreDefaultsButton"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="恢复默认"
                    Click="RestoreDefaultsButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
